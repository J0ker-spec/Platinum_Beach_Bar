{
  "expo": {
    "name": "PlatinumX",
    "slug": "platinumx",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "platinumx",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FC"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vidal.platinumx"
    },
    "android": {
      "package": "com.vidal.platinumx",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7F8FC"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "PlatinumX uses the camera to scan the workplace attendance code." }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "044ff6fe-cc12-4440-9c3a-12b61eaa732a"
      }
    }
  }
}
